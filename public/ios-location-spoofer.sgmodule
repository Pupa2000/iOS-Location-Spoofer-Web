#!name=iOS Location Spoofer (Fixed)
#!desc=拦截 Apple 定位回应并改成固定坐标。坐标写在本模块 argument 的 latitude / longitude，不请求配置服务器。【免费开源/严禁倒卖】上游: https://github.com/akudamatata/iOS-Location-Spoofer-Web
#!homepage=https://github.com/akudamatata/iOS-Location-Spoofer-Web
#!author=akudamatata

# 6708 Pacific Blvd, Huntington Park, CA 90255
[Script]
iOS Location Spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=0,timeout=30,script-path=https://cdn.jsdelivr.net/gh/Pupa2000/iOS-Location-Spoofer-Web@main/public/location-spoofer.js,argument=mode=response&latitude=33.9783852&longitude=-118.2250768&horizontalAccuracy=39&verticalAccuracy=1000&altitude=53&debug=false

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com
